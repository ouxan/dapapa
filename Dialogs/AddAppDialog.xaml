<Window x:Class="dapapa.Dialogs.AddAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add domain"
        SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Border CornerRadius="12" Background="{StaticResource BgDarkBrush}"
            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <StackPanel Margin="22">
            <TextBlock x:Name="HeadingText" Text="Add domain" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="DescriptionText"
                       Text="Enter a domain or HTTP/HTTPS URL. The name is optional."
                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="SingleDomainRadio" IsChecked="True" GroupName="InputMode" Checked="InputMode_Changed"
                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,18,0"/>
                <RadioButton x:Name="DomainListRadio" GroupName="InputMode" Checked="InputMode_Changed"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <TextBlock x:Name="AppNameLabelText" Text="Name (optional)" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="AppNameTextBox" Margin="0,0,0,14"/>

            <TextBlock x:Name="DomainLabelText" Text="Domain or URL" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="DomainTextBox" Margin="0,0,0,8"/>
            <TextBox x:Name="DomainListTextBox" Visibility="Collapsed" Height="150" AcceptsReturn="True"
                     TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Margin="0,0,0,8"/>
            <TextBlock x:Name="DomainListHintText" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="DomainScopeText" Text="This domain and its subdomains are included."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <CheckBox x:Name="DiscoverRelatedCheckBox" Content="Find related domains" IsChecked="False"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>
            <TextBlock x:Name="InputErrorText" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}"
                       FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButtonText" Content="Cancel" Style="{StaticResource GhostButton}" MinWidth="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button x:Name="ContinueButtonText" Content="Continue" Style="{StaticResource AccentButton}" MinWidth="120" Click="ContinueButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
