<Window x:Class="dapapa.Dialogs.RelatedDomainsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Related domains" Width="470" Height="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="DescriptionText" Grid.Row="1" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,12"/>
        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CandidatesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgCardBrush}" Padding="12" CornerRadius="8" Margin="0,0,0,8">
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Checked="SelectionChanged" Unchecked="SelectionChanged">
                                <StackPanel>
                                    <TextBlock Text="{Binding Domain}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ReasonText}" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Click="CancelButton_Click" Margin="0,0,8,0"/>
            <Button x:Name="AddSelectedButton" Style="{StaticResource AccentButton}" Click="AddSelectedButton_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
