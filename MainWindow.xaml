<Window x:Class="dapapa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="dapapa" Height="640" Width="520"
        Icon="pack://application:,,,/Resources/app.ico"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinWidth="460" MinHeight="560">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Storyboard x:Key="IdlePulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.65" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatusHalo" Storyboard.TargetProperty="Opacity"
                             From="0.45" To="0.1" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatusHaloScale" Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.18" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatusHaloScale" Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.18" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="BusyPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.35" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatusHalo" Storyboard.TargetProperty="Opacity"
                             From="0.7" To="0.15" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatusHaloScale" Storyboard.TargetProperty="ScaleX"
                             From="0.88" To="1.26" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatusHaloScale" Storyboard.TargetProperty="ScaleY"
                             From="0.88" To="1.26" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.32"/>
                    <DoubleAnimation Storyboard.TargetName="RootBorderTransform" Storyboard.TargetProperty="Y"
                                     From="16" To="0" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder" CornerRadius="12" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
            Opacity="0">
    <Border.RenderTransform>
        <TranslateTransform x:Name="RootBorderTransform" Y="16"/>
    </Border.RenderTransform>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                CornerRadius="12,12,0,0" Padding="20,14"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" IsHitTestVisible="False">
                    <Border Width="34" Height="34" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/app.png" Width="34" Height="34"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="dapapa" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SubtitleText" Text="Uncensored internet" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-6,-8,0">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click">
                        <Path Data="M0,0 L10,0" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" Margin="4,0,0,0">
                        <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="0" Background="Transparent"
                    SelectionChanged="MainTabControl_SelectionChanged">

            <TabItem x:Name="HomeTabItem" ToolTip="Home">
                <TabItem.Header>
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Polygon Points="12,3 21,10 21,21 3,21 3,10" Fill="White"/>
                        </Canvas>
                    </Viewbox>
                </TabItem.Header>
                <Grid Margin="20">
                    <Border x:Name="StatusCard" Background="{StaticResource BgCardBrush}" CornerRadius="14"
                            Padding="28" Margin="0" MaxWidth="380"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            BorderThickness="1.5"
                            Effect="{StaticResource CardShadowEffect}">
                        <Border.BorderBrush>
                            <SolidColorBrush x:Name="StatusCardBorderBrush" Color="{StaticResource BorderColor}"/>
                        </Border.BorderBrush>
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="46" Height="46" Margin="0,0,0,10" HorizontalAlignment="Center">
                                <Ellipse x:Name="StatusHalo" Width="44" Height="44"
                                         StrokeThickness="2" Opacity="0.35"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Stroke>
                                        <SolidColorBrush x:Name="StatusHaloBrush" Color="{StaticResource DangerColor}"/>
                                    </Ellipse.Stroke>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="StatusHaloScale" ScaleX="1" ScaleY="1" CenterX="22" CenterY="22"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="StatusDot" Width="16" Height="16"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Effect="{StaticResource DangerGlowEffect}">
                                    <Ellipse.Fill>
                                        <SolidColorBrush x:Name="StatusDotBrush" Color="{StaticResource DangerColor}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <TextBlock x:Name="StatusText" Text="Protection off" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="StatusSubText" Text="Start DPI protection below"
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,18"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

                            <Button x:Name="ToggleConnectionButton" Content="CONNECT" MinWidth="220" Height="46"
                                     Style="{StaticResource AccentButton}" FontSize="15"
                                     Click="ToggleConnectionButton_Click"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="LogHeaderText" Text="Activity Log"/>
                    </StackPanel>
                    <Border Visibility="Collapsed">
                        <ListBox x:Name="LogListBox" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="StatsTabItem" ToolTip="Statistics">
                <TabItem.Header>
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4 19h16v2H2V3h2v16zm4-3H6v-6h2v6zm5 0h-2V7h2v9zm5 0h-2v-4h2v4z" Fill="White"/>
                        </Canvas>
                    </Viewbox>
                </TabItem.Header>
                <ScrollViewer x:Name="StatsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock x:Name="StatsSectionTitleText" Text="Traffic &amp; Data Usage" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="StatsDescriptionText" Text="Total traffic on the selected network adapter, including other apps" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,16"
                                    Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#203BA55D" Margin="0,0,10,0">
                                            <Path Data="M12 4v12m0 0l-5-5m5 5l5-5" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="DownloadSpeedLabelText" Text="Download Speed" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DownloadSpeedValueText" Text="0.0 KB/s" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="CurrentDownloadSubtext" Text="Current Download" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,16"
                                    Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#205865F2" Margin="0,0,10,0">
                                            <Path Data="M12 20V8m0 0l-5 5m5-5l5 5" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="UploadSpeedLabelText" Text="Upload Speed" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="UploadSpeedValueText" Text="0.0 KB/s" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="CurrentUploadSubtext" Text="Current Upload" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,16"
                                Effect="{StaticResource CardShadowEffect}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="ChartHeaderText" Text="Live Traffic Chart" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0"/>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="ChartDownloadLegendText" Text="DL" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="ChartUploadLegendText" Text="UL" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock x:Name="ChartPeakText" Grid.Column="1" Text="Peak: 0.0 KB/s (30s)" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Background="{StaticResource BgPanelBrush}" CornerRadius="6" Height="80" ClipToBounds="True">
                                    <Grid x:Name="ChartContainer" ClipToBounds="True" SizeChanged="ChartContainer_SizeChanged">
                                        <Line X1="0" Y1="26" X2="1000" Y2="26" Stroke="{StaticResource BorderBrush2}" StrokeThickness="0.6" StrokeDashArray="3 3"/>
                                        <Line X1="0" Y1="53" X2="1000" Y2="53" Stroke="{StaticResource BorderBrush2}" StrokeThickness="0.6" StrokeDashArray="3 3"/>

                                        <Polygon x:Name="DownloadPolygon" Fill="#183BA55D"/>
                                        <Polyline x:Name="DownloadPolyline" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>

                                        <Polygon x:Name="UploadPolygon" Fill="#185865F2"/>
                                        <Polyline x:Name="UploadPolyline" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="DpiStatsHeaderText" Text="DPI &amp; Censorship Bypass Metrics" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,16" Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#205865F2" Margin="0,0,10,0">
                                            <Path Data="M4 12l5 5L20 7" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="BypassedPacketsLabelText" Text="Bypassed Packets" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="BypassedPacketsValueText" Text="0 packets" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="BypassedPacketsSubtext" Text="Selected DPI methods" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14,16" Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#203BA55D" Margin="0,0,10,0">
                                            <Path Data="M12 2L4 7v6c0 5.5 3.8 10.7 8 12 4.2-1.3 8-6.5 8-12V7l-8-5z" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="SafeDnsLabelText" Text="Local DNS Replies" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SafeDnsValueText" Text="0 queries" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="SafeDnsSubtext" Text="Selected domains, HTTPS DoH" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="DataCounterHeaderText" Text="Data Usage (This Session)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16"
                                Effect="{StaticResource CardShadowEffect}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TotalTransferredLabelText" Text="Total Transferred" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TotalTransferredValueText" Text="0.0 MB" FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="8" Background="{StaticResource BgPanelBrush}" Padding="10,6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="StatsLiveDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StatsLiveText" Text="LIVE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="ReceivedLabelText" Text="Received:" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="SessionReceivedValueText" Text="0.0 MB" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="SentLabelText" Text="Sent:" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="SessionSentValueText" Text="0.0 MB" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SessionInfoHeaderText" Text="Connection Details" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16"
                                Effect="{StaticResource CardShadowEffect}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SessionStatusLabelText" Text="Protection Status:" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="SessionStatusDot" Width="7" Height="7" Fill="{StaticResource DangerBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SessionStatusValueText" Text="Protection off" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SessionUptimeLabelText" Text="Session Duration:" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="SessionUptimeValueText" Grid.Column="1" Text="00:00" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProtectedTargetsLabelText" Text="Protected Targets:" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="ProtectedTargetsValueText" Grid.Column="1" Text="Groups: 0 · domains: 0" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AdapterLabelText" Text="Network Adapter:" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="AdapterValueText" Grid.Column="1" Text="Wi-Fi" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>

                                <Button x:Name="ResetStatsButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        Padding="12,6" FontSize="12" Click="ResetStatsButton_Click">
                                    <TextBlock x:Name="ResetStatsButtonText" Text="Reset Counters" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SettingsTabItem" ToolTip="Settings">
                <TabItem.Header>
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Line X1="4" Y1="6" X2="20" Y2="6" StrokeThickness="2.2" Stroke="White"/>
                            <Ellipse Canvas.Left="6.8" Canvas.Top="3.8" Width="4.4" Height="4.4" Fill="White"/>

                            <Line X1="4" Y1="12" X2="20" Y2="12" StrokeThickness="2.2" Stroke="White"/>
                            <Ellipse Canvas.Left="13.8" Canvas.Top="9.8" Width="4.4" Height="4.4" Fill="White"/>

                            <Line X1="4" Y1="18" X2="20" Y2="18" StrokeThickness="2.2" Stroke="White"/>
                            <Ellipse Canvas.Left="8.8" Canvas.Top="15.8" Width="4.4" Height="4.4" Fill="White"/>
                        </Canvas>
                    </Viewbox>
                </TabItem.Header>
                <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">

                        <TextBlock x:Name="GeneralHeaderText" Text="General" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,20"
                                Effect="{StaticResource CardShadowEffect}">
                            <StackPanel>
                                <CheckBox x:Name="RunOnStartupCheckBox" Content="Launch on Windows startup"
                                          Margin="0,0,0,10" Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed"/>
                                <CheckBox x:Name="StartMinimizedCheckBox" Content="Start minimized in system tray"
                                          Margin="0,0,0,10" Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed"/>
                                <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Close window to system tray"
                                          Margin="0,0,0,10" Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed"/>
                                <CheckBox x:Name="AutoConnectCheckBox" Content="Connect automatically on startup"
                                          Margin="0,0,0,10" Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed"/>
                                <CheckBox x:Name="ConnectionWatchdogCheckBox" Content="Auto-reconnect on drops (Watchdog)"
                                          Margin="0,0,0,14" Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LanguageLabelText" Grid.Column="0" Text="Language" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                    <ComboBox x:Name="LanguageComboBox" Grid.Column="1" MinWidth="140"
                                               SelectionChanged="LanguageComboBox_SelectionChanged">
                                        <ComboBoxItem Content="English"/>
                                        <ComboBoxItem Content="Türkçe"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="DohSettingsHeaderText" Text="DNS over HTTPS" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,20"
                                Effect="{StaticResource CardShadowEffect}">
                            <StackPanel>
                                <ComboBox x:Name="DohProviderComboBox" SelectionChanged="DohProvider_SelectionChanged"/>
                                <TextBlock x:Name="DohProviderDescriptionText" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                <TextBlock x:Name="DohSettingsHintText" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="DpiSettingsHeaderText" Text="DPI methods" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,20"
                                Effect="{StaticResource CardShadowEffect}">
                            <StackPanel>
                                <ComboBox x:Name="DpiModeComboBox" SelectionChanged="DpiMode_SelectionChanged">
                                    <ComboBoxItem x:Name="DpiStandardModeItem" Content="Standard"/>
                                    <ComboBoxItem x:Name="DpiCustomModeItem" Content="Custom"/>
                                </ComboBox>
                                <TextBlock x:Name="DpiModeHintText" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                <StackPanel x:Name="DpiCustomPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <CheckBox x:Name="DpiTcpFragmentationCheckBox" Content="TCP segmentation" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                    <StackPanel x:Name="DpiTcpOptionsPanel" Margin="18,0,0,12">
                                        <CheckBox x:Name="DpiReverseSegmentsCheckBox" Content="Send segments in reverse order" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                        <CheckBox x:Name="DpiSplitAtHostnameCheckBox" Content="Split inside TLS SNI / HTTP Host" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                        <CheckBox x:Name="DpiMultiSplitCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                        <TextBlock x:Name="DpiSplitSizeLabelText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                        <TextBox x:Name="DpiSplitSizeTextBox" MaxLength="4" Margin="0,0,0,12" LostFocus="DpiSetting_Changed" KeyDown="DpiInput_KeyDown"/>
                                        <TextBlock x:Name="DpiSplitPositionsLabelText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                        <TextBox x:Name="DpiSplitPositionsTextBox" MaxLength="160" Margin="0,0,0,12" LostFocus="DpiSetting_Changed" KeyDown="DpiInput_KeyDown"/>
                                    </StackPanel>
                                    <CheckBox x:Name="DpiFakeWrongChecksumCheckBox" Content="Fake packet with invalid TCP checksum" Margin="0,0,0,12" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                    <Expander x:Name="DpiFakeAdvancedExpander" Margin="0,0,0,12"
                                              Foreground="{StaticResource TextPrimaryBrush}">
                                        <StackPanel Margin="0,10,0,0">
                                            <CheckBox x:Name="DpiFakeMixSegmentsCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiFakeWrongSequenceCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiFakeLowTtlCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiFakeAutoTtlCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiFakeMd5SignatureCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiFakeTimestampCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiFakeDataNoAckCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiFakeRandomizeTlsCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <TextBlock x:Name="DpiFakeTtlLabelText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                            <TextBox x:Name="DpiFakeTtlTextBox" MaxLength="2" Margin="0,0,0,12" LostFocus="DpiSetting_Changed" KeyDown="DpiInput_KeyDown"/>
                                            <TextBlock x:Name="DpiFakeRepeatsLabelText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                            <TextBox x:Name="DpiFakeRepeatsTextBox" MaxLength="1" Margin="0,0,0,12" LostFocus="DpiSetting_Changed" KeyDown="DpiInput_KeyDown"/>
                                            <TextBlock x:Name="DpiFakeHostnameLabelText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                            <TextBox x:Name="DpiFakeHostnameTextBox" MaxLength="253" Margin="0,0,0,12" LostFocus="DpiSetting_Changed" KeyDown="DpiInput_KeyDown"/>
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock x:Name="DpiHttpMethodsLabelText" Text="HTTP only (port 80)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="DpiHttpHostHeaderCaseCheckBox" Content="Host → hOsT" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                    <CheckBox x:Name="DpiHttpHostDomainCaseCheckBox" Content="Mix hostname case" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                    <CheckBox x:Name="DpiHttpHostRemoveSpaceCheckBox" Content="Remove the space after Host:" Margin="0,0,0,14" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                    <CheckBox x:Name="DpiHttpMethodSpaceCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                    <CheckBox x:Name="DpiHttpMethodEolCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                    <CheckBox x:Name="DpiHttpHostTabCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                    <TextBlock x:Name="DpiMaxPayloadLabelText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBox x:Name="DpiMaxPayloadTextBox" MaxLength="5" Margin="0,0,0,12" LostFocus="DpiSetting_Changed" KeyDown="DpiInput_KeyDown"/>
                                    <CheckBox x:Name="DpiBlockQuicCheckBox" Content="Block QUIC for target IPs" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                    <Expander x:Name="DpiUdpExpander" Margin="0,12,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock x:Name="DpiUdpScopeText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,12"/>
                                            <CheckBox x:Name="DpiUdpFakeWrongChecksumCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiUdpFakeLowTtlCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <TextBlock x:Name="DpiUdpFakeTtlLabelText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,5"/>
                                            <TextBox x:Name="DpiUdpFakeTtlTextBox" MaxLength="2" Margin="0,0,0,12" LostFocus="DpiSetting_Changed" KeyDown="DpiInput_KeyDown"/>
                                            <TextBlock x:Name="DpiUdpFakeRepeatsLabelText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,5"/>
                                            <TextBox x:Name="DpiUdpFakeRepeatsTextBox" MaxLength="1" Margin="0,0,0,12" LostFocus="DpiSetting_Changed" KeyDown="DpiInput_KeyDown"/>
                                            <CheckBox x:Name="DpiUdpIpFragmentationCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <StackPanel x:Name="DpiUdpFragmentPanel" Margin="18,0,0,12">
                                                <CheckBox x:Name="DpiUdpReverseFragmentsCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                                <TextBlock x:Name="DpiUdpFragmentSizeLabelText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,5"/>
                                                <TextBox x:Name="DpiUdpFragmentSizeTextBox" MaxLength="4" LostFocus="DpiSetting_Changed" KeyDown="DpiInput_KeyDown"/>
                                            </StackPanel>
                                            <CheckBox x:Name="DpiUdpLengthPaddingCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <TextBlock x:Name="DpiUdpPaddingSizeLabelText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,5"/>
                                            <TextBox x:Name="DpiUdpPaddingSizeTextBox" MaxLength="2" Margin="0,0,0,12" LostFocus="DpiSetting_Changed" KeyDown="DpiInput_KeyDown"/>
                                            <TextBlock x:Name="DpiUdpPacketLimitLabelText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,5"/>
                                            <TextBox x:Name="DpiUdpPacketLimitTextBox" MaxLength="2" Margin="0,0,0,12" LostFocus="DpiSetting_Changed" KeyDown="DpiInput_KeyDown"/>
                                            <TextBlock x:Name="DpiUdpProtocolsLabelText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,8"/>
                                            <CheckBox x:Name="DpiUdpQuicInitialCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiUdpStunCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiUdpWireGuardCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiUdpDiscordDiscoveryCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <CheckBox x:Name="DpiUdpUnknownCheckBox" Margin="0,0,0,10" Checked="DpiSetting_Changed" Unchecked="DpiSetting_Changed"/>
                                            <TextBlock x:Name="DpiUdpQuicBlockedText" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock x:Name="DpiValidationText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="DpiCustomCompatibilityText" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="LatencyHeaderText" Text="DNS Response Time (DoH)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,20"
                                Effect="{StaticResource CardShadowEffect}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource BgPanelBrush}"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse x:Name="LatencyIndicatorDot" Width="12" Height="12" Fill="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="PingValueText" Text="-- ms" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border x:Name="PingBadge" CornerRadius="4" Background="#253BA55D" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="PingQualityText" Text="Excellent" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="PingTargetText" Text="HTTPS DNS query" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,8,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="12" Background="{StaticResource BgPanelBrush}" Padding="8,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PingLiveBadgeText" Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TrafficHeaderText" Text="My targets" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="SyncIpsButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Padding="8,3.5" FontSize="11" Click="SyncIpsButton_Click"
                                    ToolTip="Clear the DoH cache and refresh target IPs via Cloudflare DoH">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="SyncIconPath" Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4.01,7.58 4.01,12 C 4.01,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 L 17.65,14 C 16.83,16.33 14.61,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 L 20,11 L 20,4 L 17.65,6.35 Z"
                                          Fill="{StaticResource AccentBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="SyncIconRotate" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock x:Name="SyncIpsButtonText" Text="Sync IPs" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,20"
                                Effect="{StaticResource CardShadowEffect}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SearchBorder" Background="{StaticResource BgPanelBrush}" CornerRadius="8" Padding="10,7"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="10" Opacity="0.35" ShadowDepth="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Margin="2,0,8,0" VerticalAlignment="Center"
                                                  Data="M 7,2 A 5,5 0 1,1 2,7 A 5,5 0 0,1 7,2 M 10.5,10.5 L 14,14"
                                                  Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform"/>
                                            <TextBox x:Name="CatalogSearchTextBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" VerticalAlignment="Center"
                                                     TextChanged="CatalogSearchTextBox_TextChanged"/>
                                            <TextBlock x:Name="CatalogSearchPlaceholder" Grid.Column="1"
                                                       Text="Search sites or domains..."
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" Margin="2,0,0,0"/>
                                            <Button x:Name="ClearSearchButton" Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}"
                                                    Padding="6,2" FontSize="11" Visibility="Collapsed" Click="ClearSearchButton_Click"
                                                    ToolTip="Clear"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ActiveServicesCountText" Grid.Column="0" Text="0 / 0 active"
                                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="AddCustomAppButton" Content="Add domain" Style="{StaticResource GhostButton}"
                                                Padding="6,3.5" FontSize="11" Margin="0,0,5,0" Click="AddCustomAppButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                    <ListBox x:Name="AppsItemsControl" MaxHeight="380" Margin="0,0,0,12"
                                             FontFamily="Segoe UI"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                             PreviewMouseWheel="CatalogScrollViewer_PreviewMouseWheel">
                                        <ListBox.Template>
                                            <ControlTemplate TargetType="ListBox">
                                                <ScrollViewer x:Name="PART_ScrollViewer" Style="{StaticResource ThinScrollViewer}" Focusable="False"
                                                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ListBox.Template>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CatalogCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                                Background="{StaticResource BgCardBrush}" Margin="0,0,12,0"
                                                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                                ClipToBounds="True" VerticalAlignment="Center">
                                                            <TextBlock Text="◎" FontSize="24" Foreground="{StaticResource AccentBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Row="1" Text="{Binding SubtitleText}" FontSize="11"
                                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>

                                                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                                                                  IsChecked="{Binding Enabled, Mode=OneWay}"
                                                                  VerticalAlignment="Center" Margin="8,0,4,0"
                                                                  Checked="AppEnabledCheckBox_Changed" Unchecked="AppEnabledCheckBox_Changed"/>

                                                        <Button Grid.Column="3" Content="⋯" Style="{StaticResource GhostButton}"
                                                                Width="24" Height="24" Padding="0" Margin="4,0,2,0" FontSize="11"
                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                ToolTip="{Binding ActionLabel}"
                                                                Click="TargetActionsButton_Click" Tag="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                <TextBlock x:Name="NoResultsText" Text="No results found."
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,10,0,10" Visibility="Collapsed"/>

                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="NoteText" Text="Settings are saved automatically. Target changes apply while protection is active."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,0"/>

                        <Button x:Name="SaveSettingsButtonText" Content="Save Settings" Style="{StaticResource AccentButton}" Margin="0,16,0,0"
                                HorizontalAlignment="Stretch" Click="SaveSettingsButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
    </Border>
</Window>
